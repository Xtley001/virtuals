# Virtuals Protocol Graduation Arb — Test Engine
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.

# ============================================================
# RPC ENDPOINTS (REQUIRED — must be archive nodes for historical eth_call)
# Alchemy Growth tier includes archive access on Base — confirm before use.
# ============================================================
BASE_RPC_URL=              # e.g. https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL_FALLBACK=     # e.g. https://base-mainnet.rpc.thirdweb.com/YOUR_KEY or QuickNode

# ============================================================
# BLOCK EXPLORER API (REQUIRED)
# Get free key at: https://basescan.org/apis
# Free tier: 5 calls/second — sufficient for this engine.
# ============================================================
BASESCAN_API_KEY=          # From basescan.org/apis — free tier

# ============================================================
# PRICE DATA API (OPTIONAL but recommended)
# Without a key, CoinGecko free tier applies (10-30 calls/min).
# With a key (Pro tier), rate limits increase significantly.
# Free tier at: https://www.coingecko.com/en/api
# ============================================================
COINGECKO_API_KEY=         # Optional — free tier works but is slower
